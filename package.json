{
  "private": true,
  "name": "rtm-kit",
  "workspaces": [
    "packages/*"
  ],
  "rtmRollup": {
    "globalMap": {
      "styled-components": "styled",
      "cloneDeep": "lodash.clonedeep",
      "toPath": "lodash.topath"
    }
  },
  "scripts": {
    "bootstrap": "lerna bootstrap --no-ci",
    "build:docs": "docz build",
    "build:ci": "CI=true lerna run --parallel build -- -- --colors",
    "commit": "npx git-cz",
    "copy:builds": "node ./scripts/copyBuilds",
    "clean": "lerna exec -- rm -rf ./node_modules && lerna exec -- rm -f package-lock.json && lerna exec -- rm -rf ./build && lerna exec -- rm -rf ./coverage",
    "serve": "curl pad.js.org | node",
    "dev": "docz dev",
    "format": "rtm-scripts format --p templates/plopfile.js",
    "lint": "eslint packages",
    "test:scope": "node scripts/scoped-test tracker",
    "test:ci": "CI=true lerna run test --parallel --stream --concurrency 1299 -- -- --coverage --silent --verbose",
    "test:watch": "lerna run test --parallel --no-sort --stream --concurrency 1200 -- -- --colors --watch",
    "test:coverage": "lerna run test --parallel --no-sort --stream --concurrency 1299 -- -- --colors --coverage",
    "release": "lerna publish --yes",
    "generate": "plop --plopfile ./templates/plopfile.js",
    "watch": "lerna run --parallel build -- -- --watch --colors",
    "zip": "rtm-scripts zip --p ./aws/GithubDocumentationFunction",
    "test:package": "lerna run test --stream --scope @nirojsapkota-ui/$npm_config_package -- -- --colors --coverage"
  },
  "devDependencies": {
    "@rtm/core": "file:rtm-core",
    "@upstatement/prettier-config": "^0.3.0",
    "@xstate/react": "^0.7.1",
    "acorn": "^6.1.1",
    "acorn-dynamic-import": "^4.0.0",
    "axios": "^0.19.0",
    "babel-core": "^7.0.0-bridge.0",
    "babel-eslint": "^10.1.0",
    "babel-preset-react": "^6.24.1",
    "buble": "0.19.6",
    "color": "^3.1.1",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^2.1.0",
    "date-fns": "^1.30.1",
    "docz": "0.13.7",
    "docz-theme-default": "0.13.7",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react": "^7.19.0",
    "formik": "^2.2.9",
    "framer-motion": "^1.2.4",
    "front-matter": "^3.0.1",
    "globby": "^8.0.1",
    "handlebars": "^4.1.2",
    "husky": "4.2.3",
    "is-react": "^1.3.3",
    "lerna": "^3.22.0",
    "lerna-changelog": "^0.7.0",
    "lint-staged": "^10.1.2",
    "lodash.get": "^4.4.2",
    "meow": "^5.0.0",
    "multimatch": "^2.1.0",
    "plop": "^2.3.0",
    "polished": "^3.3.0",
    "react": "^16.8.0",
    "react-dev-utils": "^6.1.1",
    "react-dom": "^16.8.0",
    "react-helmet": "^5.2.1",
    "react-spring": "^8.0.15",
    "react-stripe-elements": "^2.0.3",
    "react-text-mask": "^5.4.3",
    "rehype-stringify": "^5.0.0",
    "remark-parse": "^6.0.3",
    "remark-rehype": "^4.0.0",
    "strip-ansi": "^4.0.0",
    "tempy": "^0.2.1",
    "text-mask-addons": "^3.8.0",
    "unified": "^7.1.0",
    "universal-cookie": "^3.0.7",
    "wait-for-localhost": "2.0.1",
    "webpack": "4.28.4",
    "xstate": "^4.7.0-rc5",
    "yup": "^0.29.3"
  },
  "dependencies": {
    "@nirojsapkota-ui/button": "file:packages/button",
    "core-js": "^3.4.7",
    "throttle-debounce": "^3.0.1"
  },
  "eslintConfig": {
    "extends": [
      "@nirojsapkota/eslint-config"
    ]
  },
  "eslintIgnore": [
    "packages/**/build/**/*.js",
    "packages/**/coverage",
    "packages/**/*.md",
    "packages/**/node_modules/*.js",
    "templates/plopfile.js"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": ""
    }
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ],
    "*.js": []
  },
  "engines": {
    "npm": "~6.14.11"
  }
}
